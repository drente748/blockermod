<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="@color/accent_dark" android:endColor="@color/accent_deep" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="0"
                android:startColor="@color/accent" android:endColor="@color/accent_deep" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
