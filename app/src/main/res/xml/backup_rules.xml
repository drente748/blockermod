<?xml version="1.0" encoding="utf-8"?>
<!--
  Backups are disabled for this app. This file is the Android 11 and older counterpart of
  data_extraction_rules.xml and exists only to exclude every domain from any backup mechanism.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
